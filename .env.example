# Set your OpenRouter API key here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter API base URL (OpenAI-compatible)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing: math content -> LLM_MODEL_MATH, everything else -> LLM_MODEL_NORMAL
LLM_MODEL_NORMAL=z-ai/glm-5.3-flash        # Z.ai: GLM 5.3 Flash
LLM_MODEL_MATH=xiaomi/mimo-v2.6-pro        # Xiaomi: MiMo-V2.6-Pro

# USD per million tokens for the two configured models (used by run reports).
LLM_MODEL_NORMAL_INPUT_1M=0
LLM_MODEL_NORMAL_OUTPUT_1M=0
LLM_MODEL_MATH_INPUT_1M=0
LLM_MODEL_MATH_OUTPUT_1M=0
# Optional cached-input rate; when omitted, each model's normal input rate applies.
# KP_PRICE_CACHED_PER_M=0

# Optional: Customize model settings
TEMPERATURE=0.7

# Mindmap generation settings
MINDMAP_MULTI_PASS="true"
MINDMAP_CHUNK_SIZE_CHARS="1024"         # smaller chunks → more passes, better coverage
MINDMAP_CHUNK_OVERLAP_CHARS="300"       # more overlap to avoid missing boundary info
MINDMAP_DEDUPLICATE_NODES="true"        # keep; set to "false" if you suspect over-deduplication
MINDMAP_MAX_NODES="300"

# MongoDB connection (ai storage + ien/ien-v2 + tahdiri)
MONGODB_URI=mongodb://user:pass@host:27017/ai?directConnection=true&serverSelectionTimeoutMS=2000&authSource=admin

# Knowledge production: reads existing summaries, worksheets and questions only
# KP_MONGO_URI falls back to MONGODB_URI when omitted.
KP_MONGO_DB=ai
KP_COL_SUMMARIES=summaries
KP_COL_WORKSHEETS=worksheets
KP_COL_QUESTIONS=questions
KP_COL_KNOWLEDGE=knowledge_productions
KP_MAX_QUESTIONS=3
KP_MAX_REPAIRS=2
# Low reasoning for mechanical question adaptation; provider uses model defaults.
KP_LINK_REASONING_EFFORT=low
# Optional for reasoning-heavy creative models; "provider" restores their default.
KP_CREATIVE_REASONING_EFFORT=low
KP_MAX_TOKENS=6000
# Retry a truncated response once up to this cap; use 6000 to disable.
KP_MAX_RETRY_TOKENS=12000
KP_REQUEST_TIMEOUT=180
# Optional model overrides; otherwise use existing LLM_MODEL_MATH/NORMAL.
# KP_MODEL_CREATIVE=your/model-id
# KP_MODEL_LINK=your/model-id
